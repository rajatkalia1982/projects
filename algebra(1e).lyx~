\begin_layout Description
Comprehension 1:
 Let a ,
 b ,
 c be three distinct real numbers and 
\begin_inset Formula $f(x)$
\end_inset

 be a quadratic polynomial satisfying the equation
\end_layout

\begin_layout Description
\begin_inset Formula $\left[\begin{array}{ccc}
9a^{2} & 9a & 1\\
9b^{2} & 9b & 1\\
9c^{2} & 9c & 1
\end{array}\right]\left[\begin{array}{c}
f\left(-1\right)\\
f\left(-2\right)\\
f\left(-3\right)
\end{array}\right]=\left[\begin{array}{c}
16a^{2}+10a\\
16b^{2}+10b\\
16c^{2}+10c
\end{array}\right]$
\end_inset

 .
 Let 
\begin_inset Formula $V$
\end_inset

 be a point of local maxima of 
\begin_inset Formula $y=f(x)$
\end_inset

 and 
\begin_inset Formula $A$
\end_inset

 be the point where 
\begin_inset Formula $y=f(x)$
\end_inset

 meets the x-axis and 
\begin_inset Formula $B$
\end_inset

 be a point on 
\begin_inset Formula $y=f(x)$
\end_inset

 such that 
\begin_inset Formula $AB$
\end_inset

 subtends a right angle at 
\begin_inset Formula $V$
\end_inset


\end_layout

