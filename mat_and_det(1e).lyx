 Let 
\begin_inset Formula $A=\left[\begin{array}{cc}
1 & 2\\
1 & \alpha
\end{array}\right]$
\end_inset

 and 
\begin_inset Formula $B=\left[\begin{array}{cc}
3 & 3\\
\beta & 2
\end{array}\right]$
\end_inset

.
 If 
\begin_inset Formula $A^{2}-4A+I=0$
\end_inset

 and 
\begin_inset Formula $B^{2}-5B-6I=0$
\end_inset

,
 then among the two statements :
 
\end_layout

\begin_layout Standard
(S1) :
 
\begin_inset Formula $\left[\left(B-A\right)\left(B+A\right)\right]^{T}=\left[\begin{array}{cc}
13 & 15\\
7 & 10
\end{array}\right]$
\end_inset


\end_layout

\begin_layout Standard
(S2) :
 
\begin_inset Formula $det\left(adj\left(A+B\right)\right)=-5$
\end_inset

,
\end_layout

