\begin_layout Standard
Q1:
 Let an ellipse 
\begin_inset Formula $\dfrac{x^{2}}{a^{2}}+\dfrac{y^{2}}{b^{2}}=1$
\end_inset

,
 
\begin_inset Formula $a<b,$
\end_inset

pass through the point 
\begin_inset Formula $(4,3)$
\end_inset

 and have eccentricity 
\begin_inset Formula $\dfrac{\sqrt{5}}{3}$
\end_inset

.
 Then the length of it's latus rectum is :
\end_layout

\begin_layout Standard
[ JEE Mains 2nd April 2026 Shift 1 Q10 ]
\end_layout

\begin_layout Standard
(A) 
\begin_inset Formula $\dfrac{4\sqrt{5}}{3}$
\end_inset


\end_layout

\begin_layout Standard
(B) 
\begin_inset Formula $2\sqrt{5}$
\end_inset


\end_layout

\begin_layout Standard
(C) 
\begin_inset Formula $\dfrac{7\sqrt{5}}{3}$
\end_inset


\end_layout

\begin_layout Standard
(D) 
