\begin_layout Standard
Let the stream velocity be 
\begin_inset Formula $v_{o}$
\end_inset

 ,
 then the boat velocity with respect to water is 
\begin_inset Formula $\eta v_{o}$
\end_inset

 .
 Also let us assume that the equal distance be d.
\end_layout

\begin_layout Standard

\series bold
Case A
\series default
 :
 Final velocity of boat A in forward journey ( in the stream direction )
\end_layout

\begin_layout Standard
\begin_inset Formula $v=\eta v_{o}+v_{o}=(\eta+1)v_{o}$
\end_inset


\end_layout

\begin_layout Standard
Time to reach the destination =
\begin_inset Formula $t_{1}=\dfrac{d}{(\eta+1)v_{o}}$
\end_inset

 ............(1)
\end_layout

\begin_layout Standard
Final velocity of boat A in the backward journey ( opposite to the stream direction )
\end_layout

\begin_layout Standard
\begin_inset Formula $v=\eta v_{o}-v_{o}=(\eta-1)v_{o}$
\end_inset


\end_layout

\begin_layout Standard
Time to reach back to the buoy =
\begin_inset Formula $t_{2}=\dfrac{d}{(\eta-1)v_{o}}$
\end_inset

 ............(2)
\end_layout

\begin_layout Standard
\begin_inset Formula $\tau_{A}=t_{1}+t_{2}=\dfrac{d}{(\eta+1)v_{o}}+\dfrac{d}{(\eta-1)v_{o}}=\dfrac{2\eta}{\eta^{2}-1}\dfrac{d}{v_{o}}$
\end_inset


\end_layout

\begin_layout Standard

\series bold
Case B :
 
\series default
Here we proceed according to the shortest path case in Theory Problem 1.
\end_layout

\begin_layout Standard
In Forward Journey (Upwards in the figure)
\end_layout

\begin_layout Standard
\begin_inset Formula $t_{1}=\dfrac{d}{\sqrt{\eta^{2}-1}v_{o}}$
\end_inset


\end_layout

\begin_layout Standard
In Backwards Journey (Downwards in the figure)
\end_layout

\begin_layout Standard
\begin_inset Formula $t_{2}=\dfrac{d}{\sqrt{\eta^{2}-1}v_{o}}=t_{1}$
\end_inset


\end_layout

