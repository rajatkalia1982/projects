\begin_layout Standard
Across component(along y axis) of v is 
\begin_inset Formula $v'\sin\theta$
\end_inset


\end_layout

\begin_layout Standard
Drift component(along x axis) of v is 
\begin_inset Formula $v'\cos\vartheta+v_{o}$
\end_inset


\end_layout

\begin_layout Standard
drift = 
\begin_inset Formula $\dfrac{AB}{v'\sin\theta}\left(v'\cos\vartheta+v_{o}\right)=AB\left(\cot\theta+\dfrac{v_{o}}{v'}cosec\theta\right)=AB\left(\cot\theta+ncosec\theta\right)$
\end_inset


\end_layout

\begin_layout Standard
Now we have to minimize drift,
 
\end_layout

\begin_layout Standard
At minima,
 
\begin_inset Formula $\dfrac{d}{d\theta}drift=0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\Rightarrow\dfrac{d}{d\theta}AB\left(\cot\theta+ncosec\theta\right)=0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\Rightarrow AB(cosec^{2}\theta+ncosec\theta\cot\theta)=0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\Rightarrow\cos\vartheta=-\dfrac{1}{n}$
\end_inset


\end_layout

\begin_layout Standard
The only solution in (0,π) is 120
\begin_inset Formula $^{o}$
\end_inset

