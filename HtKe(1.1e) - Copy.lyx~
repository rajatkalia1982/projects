\begin_layout Standard
Area under the v-t graph is dispacement(s)
\end_layout

\begin_layout Standard
Area of a trapezium is sum of parallel sides X distance between them
\end_layout

\begin_layout Standard
\begin_inset Formula $\Rightarrow s=\dfrac{v+v_{o}}{2}t$
\end_inset


\end_layout

\begin_layout Standard
Substituting, the previously derived newton's first equation of motion in
 scalar form
\end_layout

\begin_layout Standard
\begin_inset Formula $\Rightarrow s=\dfrac{v_{o}+at+v_{o}}{2}t$
\end_inset


\end_layout

\begin_layout Standard
OR
\end_layout

\begin_layout Standard
\begin_inset Formula $s=v_{o}t+\dfrac{1}{2}at^{2}$
\end_inset


\end_layout

